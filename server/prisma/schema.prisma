// SmartHostel — Prisma Schema
// Hybrid architecture: Core monolith + 2 microservices
// ACID properties enforced via Prisma transactions + raw SQL locking

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================
// ENUMS
// ========================

enum Role {
  STUDENT
  COMMITTEE
  ADMIN
  WARDEN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ComplaintCategory {
  FOOD_QUALITY
  FOOD_QUANTITY
  HYGIENE
  INFRASTRUCTURE
  STAFF_BEHAVIOUR
  OTHER
}

enum MealType {
  BREAKFAST
  LUNCH
  SNACKS
  DINNER
}

enum RebateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum NotificationType {
  ANNOUNCEMENT
  COMPLAINT_UPDATE
  REBATE_UPDATE
  MEAL_REMINDER
  EMERGENCY
  GENERAL
}

enum Shift {
  MORNING
  AFTERNOON
  EVENING
  NIGHT
}

enum RoomType {
  SINGLE
  DOUBLE
  TRIPLE
  DORMITORY
}

enum AnnouncementCategory {
  GENERAL
  ACADEMIC
  MAINTENANCE
  EVENT
  EMERGENCY
}

enum AnnouncementPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceType {
  MEAL
  NIGHT_CHECKIN
  GATE_ENTRY
  EVENT
}

// ========================
// CORE MODELS
// ========================

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String? // Nullable: Google OAuth users have no password
  role            Role     @default(STUDENT)
  primaryRole     Role     @default(STUDENT) // Original base role — never changed on elevation
  isEmailVerified Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  studentProfile  StudentProfile?
  googleAccount   GoogleAccount?
  notifications   Notification[]
  complaints      Complaint[]
  responses       ComplaintResponse[]
  rebates         Rebate[]
  attendance      Attendance[]
  dailyAttendance DailyAttendance[]   @relation("DailyAttendance")
  sentMessages    ChatMessage[]       @relation("SentMessages")
  feedback        Feedback[]
  emailVerTokens  EmailVerification[]
  passwordResets  PasswordReset[]
  announcements   Announcement[]

  @@index([email])
  @@index([role])
  @@index([primaryRole])
}

// OAuth: one Google account per User
model GoogleAccount {
  id          String   @id @default(uuid())
  userId      String   @unique
  googleId    String   @unique
  displayName String?
  avatarUrl   String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([googleId])
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  otp       String   @default("")
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

// Idempotency: prevents duplicate writes from client retries
// Store idempotency key → result for 24h
model IdempotencyKey {
  id        String   @id @default(uuid())
  key       String   @unique
  userId    String
  resource  String // e.g. "rebate", "complaint"
  result    Json // Cached response body
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([key])
  @@index([userId, resource])
}

model StudentProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  rollNumber     String   @unique
  name           String
  phone          String?
  gender         Gender
  department     String
  year           Int
  blockId        String?
  roomNumber     String?
  profilePicture String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  block       HostelBlock?     @relation(fields: [blockId], references: [id])
  allocations RoomAllocation[]
  bookings    RoomBooking[]

  @@index([rollNumber])
  @@index([blockId])
}

model HostelBlock {
  id               String   @id @default(uuid())
  name             String   @unique
  capacity         Int
  currentOccupancy Int      @default(0)
  wardenId         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  students StudentProfile[]
  rooms    Room[]

  @@index([name])
}

model Room {
  id               String   @id @default(uuid())
  blockId          String
  roomNumber       String
  floor            Int
  capacity         Int      @default(2)
  currentOccupancy Int      @default(0)
  type             RoomType @default(DOUBLE)
  isAvailable      Boolean  @default(true)
  amenities        String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  block       HostelBlock      @relation(fields: [blockId], references: [id], onDelete: Cascade)
  allocations RoomAllocation[]
  beds        Bed[]
  bookings    RoomBooking[]

  @@unique([blockId, roomNumber])
  @@index([blockId])
  @@index([isAvailable])
}

model Bed {
  id         String   @id @default(uuid())
  roomId     String
  bedNumber  String
  isOccupied Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  room        Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  allocations RoomAllocation[]

  @@unique([roomId, bedNumber])
  @@index([roomId])
  @@index([isOccupied])
}

model RoomAllocation {
  id               String    @id @default(uuid())
  roomId           String
  bedId            String?
  studentProfileId String
  allocatedAt      DateTime  @default(now())
  vacatedAt        DateTime?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())

  room    Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bed     Bed?           @relation(fields: [bedId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([bedId])
  @@index([studentProfileId])
  @@index([isActive])
}

model RoomBooking {
  id               String        @id @default(uuid())
  studentProfileId String
  roomId           String
  status           BookingStatus @default(PENDING)
  notes            String?
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  student StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  room    Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([studentProfileId])
  @@index([roomId])
  @@index([status])
}

// ========================
// MENU & MEALS
// ========================

model Menu {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schedules MealSchedule[]
}

model MealItem {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String
  isVeg       Boolean  @default(true)
  calories    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schedules MealSchedule[] @relation("MealItems")
}

model MealSchedule {
  id        String    @id @default(uuid())
  menuId    String
  mealType  MealType
  dayOfWeek Int // 0=Sunday, 6=Saturday
  date      DateTime?
  startTime String
  endTime   String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  menu       Menu         @relation(fields: [menuId], references: [id], onDelete: Cascade)
  items      MealItem[]   @relation("MealItems")
  attendance Attendance[]

  @@index([menuId])
  @@index([mealType])
  @@index([dayOfWeek])
}

// ========================
// COMPLAINTS
// ========================

model Complaint {
  id          String            @id @default(uuid())
  userId      String
  title       String
  description String
  category    ComplaintCategory
  status      ComplaintStatus   @default(OPEN)
  imageUrl    String?
  isAnonymous Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses ComplaintResponse[]

  @@index([userId])
  @@index([status])
  @@index([category])
}

model ComplaintResponse {
  id          String   @id @default(uuid())
  complaintId String
  userId      String
  message     String
  createdAt   DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([complaintId])
}

// ========================
// REBATES
// ACID: create uses SELECT FOR UPDATE + transaction to prevent concurrent overlap
// ABAC: reviewer.userId must != rebate.userId (enforced in service)
// ========================

model Rebate {
  id         String       @id @default(uuid())
  userId     String
  fromDate   DateTime
  toDate     DateTime
  reason     String
  status     RebateStatus @default(PENDING)
  reviewedBy String?
  reviewNote String?
  reviewedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([userId, status]) // Composite for overlap check queries
  @@index([fromDate, toDate]) // Composite for date range queries
}

// ========================
// INVENTORY
// ========================

model InventoryItem {
  id              String   @id @default(uuid())
  name            String
  unit            String
  currentStock    Float
  minimumStock    Float
  maximumCapacity Float
  pricePerUnit    Float
  supplier        String?
  category        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchases Purchase[]

  @@index([name])
  @@index([category])
}

model Purchase {
  id            String   @id @default(uuid())
  itemId        String
  quantity      Float
  pricePerUnit  Float
  totalAmount   Float
  supplier      String
  purchasedBy   String
  invoiceNumber String?
  purchaseDate  DateTime @default(now())
  createdAt     DateTime @default(now())

  item InventoryItem @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@index([purchasedBy])
}

// ========================
// NOTIFICATIONS
// Async email delivery via Redis pub/sub → notification-worker microservice
// ========================

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(GENERAL)
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([userId, isRead, createdAt]) // Composite for unread query
}

// ========================
// ATTENDANCE
// Manual marking by committee — no QR scanner
// attendance-service microservice handles mark/mark-bulk
// ABAC: marker.userId must != student.userId
// ========================

model Attendance {
  id         String           @id @default(uuid())
  userId     String // Student being marked
  scheduleId String
  status     AttendanceStatus
  markedById String? // Committee member who marked it (ABAC audit trail)
  markedAt   DateTime         @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule MealSchedule @relation(fields: [scheduleId], references: [id])

  @@unique([userId, scheduleId])
  @@index([userId])
  @@index([scheduleId])
  @@index([markedById])
  @@index([userId, markedAt]) // For monthly attendance reports
}

model DailyAttendance {
  id         String           @id @default(uuid())
  userId     String
  date       DateTime         @default(now())
  type       AttendanceType   @default(NIGHT_CHECKIN)
  status     AttendanceStatus @default(PRESENT)
  qrToken    String?          @unique
  verifiedAt DateTime?
  verifiedBy String?
  remarks    String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user User @relation("DailyAttendance", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@index([type])
  @@index([status])
  @@index([qrToken])
}

// ========================
// FEEDBACK
// ========================

model Feedback {
  id         String   @id @default(uuid())
  userId     String
  scheduleId String?
  rating     Int // 1-5
  comment    String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([rating])
}

// ========================
// WORKERS / STAFF
// ========================

model Worker {
  id          String   @id @default(uuid())
  name        String
  phone       String
  email       String?  @unique
  designation String
  shift       Shift    @default(MORNING)
  salary      Float
  joiningDate DateTime @default(now())
  isActive    Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shift])
  @@index([isActive])
  @@index([shift, isActive])
}

// ========================
// CHAT
// ========================

model ChatRoom {
  id        String   @id @default(uuid())
  name      String
  isGroup   Boolean  @default(false)
  createdAt DateTime @default(now())

  messages ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(uuid())
  roomId    String
  senderId  String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([senderId])
}

// ========================
// ANNOUNCEMENTS / NOTICE BOARD
// ========================

model Announcement {
  id            String               @id @default(uuid())
  title         String
  content       String
  priority      AnnouncementPriority @default(MEDIUM)
  category      AnnouncementCategory @default(GENERAL)
  authorId      String
  targetRoles   String[] // Which roles can see it, e.g. ["STUDENT","COMMITTEE"]
  isPinned      Boolean              @default(false)
  isActive      Boolean              @default(true)
  expiresAt     DateTime?
  attachmentUrl String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([category])
  @@index([priority])
  @@index([isPinned, isActive])
  @@index([isActive, createdAt])
}
